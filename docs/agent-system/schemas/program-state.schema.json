{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thedailyline.bet/schemas/dlads-program-state-v1.json",
  "title": "DLADS Program State V1",
  "type": "object",
  "required": ["schema_version", "updated_at", "authority", "current_phase", "current_task", "macro_sequence", "repositories", "policy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "updated_at": {"type": "string"},
    "authority": {"const": "program-coordination-only"},
    "current_phase": {"type": "string"},
    "current_task": {
      "type": "object",
      "required": ["id", "title", "status", "target_repository", "details"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "status": {"type": "string"},
        "target_repository": {"type": "string"},
        "details": {"type": "string"}
      },
      "additionalProperties": false
    },
    "macro_sequence": {"type": "array", "items": {"type": "string"}},
    "repositories": {"type": "object", "additionalProperties": {"type": "object"}},
    "policy": {"type": "object"}
  },
  "additionalProperties": false
}